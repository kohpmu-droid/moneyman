# Copy to `.env` and fill in. NEVER commit the real .env file.

# System-user or page access token with ads_management, leads_retrieval,
# pages_manage_ads, pages_read_engagement, business_management.
META_ACCESS_TOKEN=

# Your ad account id (digits only, or with the act_ prefix — both work).
META_AD_ACCOUNT_ID=

# The Facebook Page the ads run from.
META_PAGE_ID=

# Optional: the connected Instagram account id, to also run on Instagram.
META_INSTAGRAM_ACTOR_ID=

# Optional: Graph API version. Defaults to v21.0.
GRAPH_API_VERSION=v21.0

# Safety flags — keep both off while testing.
# When true, the campaign/ad set/ad are created ACTIVE and will spend budget
# once Meta approves them. Leave false to create everything PAUSED.
ACTIVATE_ADS=false

# When true, prints the requests instead of sending them. Great for a dry run.
DRY_RUN=false

# ---------------------------------------------------------------------------
# Lead -> Google Sheet sync (only needed for `npm run sync-leads`)
# ---------------------------------------------------------------------------

# The target spreadsheet id (from its URL: /spreadsheets/d/<THIS>/edit).
GOOGLE_SHEET_ID=

# Tab (worksheet) name to write into. Defaults to "Leads".
GOOGLE_SHEET_TAB=Leads

# Service-account credentials — use ONE of these:
#   a path to the downloaded JSON key file...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
#   ...or the whole JSON inline (handy for CI secrets). Leave the file var empty if you use this.
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: comma-separated lead form ids to sync. Empty = sync every form on the page.
LEAD_FORM_IDS=

# ---------------------------------------------------------------------------
# WhatsApp notification on each new lead (optional — leave empty to disable)
# ---------------------------------------------------------------------------

# From WhatsApp > API setup in Meta. The phone-number id (not the phone number).
WHATSAPP_PHONE_NUMBER_ID=

# Where to send the alert — your number, international format, digits only (e.g. 972501234567).
WHATSAPP_TO=

# Token with whatsapp_business_messaging. Falls back to META_ACCESS_TOKEN if unset.
WHATSAPP_ACCESS_TOKEN=

# "template" (default, works anytime) or "text" (only within 24h of you messaging the number — good for testing).
WHATSAPP_MODE=template

# For template mode: your approved template name + language. Body must have 3 variables: {{1}} name, {{2}} phone, {{3}} email.
WHATSAPP_TEMPLATE_NAME=new_lead
WHATSAPP_TEMPLATE_LANG=he

# Safety cap: max notifications per sync run (avoids a first-run backlog blast).
WHATSAPP_MAX_PER_RUN=20

# ---------------------------------------------------------------------------
# "Just ask" brief generator (only needed for `npm run generate`)
# ---------------------------------------------------------------------------

# Anthropic API key — the generator uses Claude to write the ad from your request.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# Your privacy-policy URL, stamped into generated lead forms (Meta requires it).
PRIVACY_POLICY_URL=

# Optional: path to a Chromium binary for rendering the ad image, if Playwright
# can't find its own. Leave empty on a normal `npx playwright install chromium` setup.
PLAYWRIGHT_CHROMIUM_PATH=
